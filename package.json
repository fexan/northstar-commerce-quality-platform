{
  "name": "northstar-commerce-quality",
  "version": "0.1.0",
  "private": true,
  "description": "Playwright quality platform for the Northstar Commerce Medusa storefront",
  "scripts": {
    "test": "playwright test",
    "test:smoke": "playwright test --grep @smoke",
    "test:regression": "playwright test --project=chromium",
    "test:cross-browser": "playwright test --project=chromium --project=firefox-smoke --project=webkit-smoke --grep @smoke",
    "test:auth": "playwright test automation/tests/ui/authentication",
    "test:checkout": "playwright test automation/tests/ui/checkout",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "demo:checkout": "PLAYWRIGHT_VIDEO=on playwright test automation/tests/ui/checkout/checkout.spec.ts --project=chromium --grep @smoke --workers=1 --headed",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^9.31.0",
    "@playwright/test": "^1.54.1",
    "@types/node": "^24.0.15",
    "dotenv": "^17.4.2",
    "eslint": "^9.31.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.3.0",
    "prettier": "^3.6.2",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.38.0"
  }
}
